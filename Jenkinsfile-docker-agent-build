pipeline {
    agent any
    environment {
        CUSTOM_DOCKER_AGENT_IMAGE = "jenkins-aws-docker-agent"
    }
    stages {
        stage('Build Custom Docker Agent Image') {
            agent any
            steps {
                sh "docker build -t ${CUSTOM_DOCKER_AGENT_IMAGE} -f Dockerfile.jenkins-aws-docker ."
            }
        }
    }
}
