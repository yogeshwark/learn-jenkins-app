pipeline {
    agent any
    environment {
        REACT_APP_VERSION = "1.0.$BUILD_ID"
        AWS_DEFAULT_REGION = "eu-north-1"
        ECS_CLUSTER_NAME = "LearnJenkinsCluster"
        ECS_SERVICE_NAME = "Learn-Jenkins-Task-Definition-service-gmocq5rp"
        ECR_REPOSITORY_NAME = "learn-jenkins-app"
        IMAGE_TAG = "1.0.$BUILD_ID"
        AWS_ACCOUNT_ID = "YOUR_AWS_ACCOUNT_ID" // TODO: Replace with your actual AWS Account ID
    }
    stages {
        stage('Build Website') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'echo "Starting Website Build Stage..."'
                sh 'echo "Node Version:"'
                sh 'node --version'
                sh 'echo "NPM Version:"'
                sh 'npm --version'
                sh 'echo "Installing dependencies..."'
                sh 'npm ci'
                sh 'echo "Running build..."'
                sh 'npm run build'
                sh 'echo "Website Build Stage Completed."'
            }
        }
        stage('Build & Push Docker Image') {
            agent {
                docker {
                    image 'amazon/aws-cli:2.13.2'
                    reuseNode true
                    args "-u root -v /var/run/docker.sock:/var/run/docker.sock --entrypoint=''"
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws-auth', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID')]) {
                    sh '''
                        amazon-linux-extras install docker
                        echo "Checking Docker availability..."
                        docker info
                        # Build Docker image
                        docker build -t ${ECR_REPOSITORY_NAME}:${IMAGE_TAG} .
                        echo "Docker Image Build & Push Stage Completed."
                    '''
                }
            }
        }
        stage('Deploy to AWS ECS') {
            agent {
                docker {
                    image 'amazon/aws-cli:2.13.2'
                    reuseNode true
                    args "-u root -v /var/run/docker.sock:/var/run/docker.sock --entrypoint=''"
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws-auth', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID')]) {
                    sh '''
                        echo "AWS CLI Version:"
                        aws --version
                        
                        # Update task definition with new image
                        TASK_DEFINITION_JSON=$(aws ecs describe-task-definition --task-definition Learn-Jenkins-Task-Definition --query taskDefinition --output json)
                        UPDATED_TASK_DEFINITION_JSON=$(echo $TASK_DEFINITION_JSON | jq --arg IMAGE "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY_NAME}:${IMAGE_TAG}" '.containerDefinitions[0].image = $IMAGE | del(.taskDefinitionArn) | del(.revision) | del(.status) | del(.compatibilities) | del(.requiresAttributes) | del(.registeredAt) | del(.registeredBy)')
                        
                        LATEST_TD_REVISION=$(aws ecs register-task-definition --cli-input-json "$UPDATED_TASK_DEFINITION_JSON" | jq '.taskDefinition.revision')
                        echo $LATEST_TD_REVISION
                        aws ecs update-service --cluster ${ECS_CLUSTER_NAME} --service ${ECS_SERVICE_NAME} --task-definition Learn-Jenkins-Task-Definition:$LATEST_TD_REVISION
                        aws ecs wait services-stable --cluster ${ECS_CLUSTER_NAME} --services ${ECS_SERVICE_NAME}
                        echo "Deployment to AWS ECS Completed."
                    '''
                }
            }
        }
    }
}
